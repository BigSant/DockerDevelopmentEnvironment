# Base local-dev MySQL tuning — mounted as conf.d/my.cnf.
# Overridden by profile (conf.d/zz-profile.cnf) and per-project config (project.d/).
# See doc/ARCHITECTURE.md §8 for the config cascade.

[mysqld]
# Local dev: no crash-safety needed — eliminate fsync overhead.
innodb_flush_log_at_trx_commit = 2
sync_binlog = 0
disable_log_bin

# Disable performance monitoring (saves ~400MB RAM). Enable per project when you need
# query analysis — e.g. project.d/perf.cnf or the profile my.cnf: performance_schema = ON.
performance_schema = OFF

# Modest buffer pool for local datasets; raise per project if needed.
innodb_buffer_pool_size = 256M
