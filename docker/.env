# Project
PROJECT_NAME=""
DOMAIN=""
PROFILE=prestashop # Currently available: "prestashop", "akeneo", "" (empty)

# Which optional containers to launch (docker compose profiles). Core services
# (nginx-proxy, apache/webserver, php-fpm, mysql) always run. Override per project
# in the project's app/docker/.env.local.
# Available: phpcs, phpstan, mailpit, pma, cron, playwright
COMPOSE_PROFILES=mailpit,pma,cron

LOCALHOST_PORT=0
LOCALHOST_PORT_SSL=0

# Nginx
NGINX_VERSION=1.26.0
WEBSERVICE_TIMEOUT=90 # seconds
WHITELISTED_IP='allow all;'
DOCUMENT_ROOT=/

# Apache
APACHE_VERSION=2.4.59

# Database
MARIADB_VERSION=11.3.2 # Compatible version list: https://endoflife.date/mariadb
MYSQL_VERSION=8.4.0 # Compatible version list: https://endoflife.date/mysql
DATABASE_HOST=127.0.0.1
DATABASE_USER=""
DATABASE_PASSWORD=""
DATABASE_NAME=""

# PHP
PHP_VERSION=8.1
XDEBUG_VERSION=3.1.5 # Compatible version list: https://xdebug.org/docs/compat (exact version: https://github.com/xdebug/xdebug/tags)
APCU_VERSION=5.1.28 # pecl apcu baked into the php-fpm base image (8.x only). Was unpinned (`pecl install apcu`).
COMPOSER_VERSION=2.7.6 # Compatible version with PHP: https://endoflife.date/composer
PMA_VERSION=5.2.3 # Compatible version with PHP and MariaDB: https://endoflife.date/phpmyadmin
PHP_PHPSTAN_VERSION="2.2.2-php8.1" # exact pin (was floating "2-php8.1"). Tags: https://phpstan.org/user-guide/docker#supported-tags
PHPSTAN_PHAR_VERSION=1.12.33 # phpstan.phar baked into the php-fpm image as a CLI (was floating ":1"). NOTE: still 1.x while the php-phpstan service uses 2.x — unify when convenient.
DOCTRINE_MIGRATIONS_VERSION=3.8 # Supported versions: https://github.com/doctrine/migrations/releases (php-doctrine-migrations service is currently disabled)
PHP_CS_VERSION="3.95.10-php8.1" # exact pin (was floating "3-php8.1"). Tags: https://github.com/php-cs-fixer/PHP-CS-Fixer/pkgs/container/php-cs-fixer
NODE_VERSION=22.23.1 # exact patch pin (was floating "22") — installed via nvm into the php-fpm base

# PHP tuning
PHP_MEMORY_LIMIT=512M
PHP_MAX_EXECUTION_TIME=30
PHP_UPLOAD_MAX_FILESIZE=20M
PHP_POST_MAX_SIZE=20M

# Profilers
MAILPIT_VERSION=1.18.3

# Testing / E2E
PLAYWRIGHT_VERSION=1.61.1 # Available tags: https://mcr.microsoft.com/v2/playwright/tags/list (turi atitikti @playwright/test)

