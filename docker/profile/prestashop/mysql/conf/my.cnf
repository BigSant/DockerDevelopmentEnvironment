[mysqld]
# PrestaShop-specific MySQL tuning — loaded as conf.d/zz-profile.cnf (overrides base my.cnf).
# Active only when PROFILE=prestashop.

# PrestaShop (1.6/1.7/8.x) is not fully compatible with MySQL 8's default sql_mode:
#   - ONLY_FULL_GROUP_BY breaks many core/module GROUP BY queries
#   - NO_ZERO_DATE / NO_ZERO_IN_DATE reject PrestaShop's '0000-00-00' defaults
# Uncomment to relax to a PrestaShop-friendly mode (adjust per project if needed):
#sql_mode = "STRICT_TRANS_TABLES,ERROR_FOR_DIVISION_BY_ZERO,NO_ENGINE_SUBSTITUTION"

#mysql_native_password=ON
#log_error_verbosity=3