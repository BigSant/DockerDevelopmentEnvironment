[mysqld]
# PrestaShop-specific MariaDB tuning — loaded as conf.d/zz-profile.cnf (overrides base my.cnf).
# Active only when PROFILE=prestashop.
#
# MariaDB's default sql_mode differs from MySQL 8, but ONLY_FULL_GROUP_BY / NO_ZERO_DATE can
# still break PrestaShop. Uncomment to relax to a PrestaShop-friendly mode:
#sql_mode = "STRICT_TRANS_TABLES,ERROR_FOR_DIVISION_BY_ZERO,NO_ENGINE_SUBSTITUTION"
