[mysqld]
# Akeneo-specific MySQL tuning — loaded as conf.d/zz-profile.cnf (overrides base my.cnf).
# Active only when PROFILE=akeneo.
#
# Akeneo PIM has its own DB requirements, e.g.:
#   - group_concat_max_len raised for large product/export queries
#   - innodb_buffer_pool_size sized for catalog volume
# Add the directives required by your Akeneo version here:
#group_concat_max_len = 1000000
