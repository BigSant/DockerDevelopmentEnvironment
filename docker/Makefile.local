APP_DOCKER_DIRECTORY:=$(shell dirname $(realpath $(firstword $(MAKEFILE_LIST))))
ROOT_DIRECTORY:=$(abspath $(APP_DOCKER_DIRECTORY)/../../)
# Central setup repo's docker dir — resolved dynamically as the sibling
# .../Projects/setup/docker (projects are created next to the setup repo).
# Override DOCKER_DIRECTORY=... on the CLI/env if your layout differs.
DOCKER_DIRECTORY?=$(abspath $(ROOT_DIRECTORY)/../setup/docker)
SQL_DUMP_FILE:=$(or $(wordlist 2, $(words $(MAKECMDGOALS)), $(MAKECMDGOALS)), $(file))

up:
	$(MAKE) -C $(DOCKER_DIRECTORY) local PROJECT_DIRECTORY=$(ROOT_DIRECTORY)

down:
	$(MAKE) -C $(DOCKER_DIRECTORY) down-local PROJECT_DIRECTORY=$(ROOT_DIRECTORY)

db:
	$(MAKE) -C $(DOCKER_DIRECTORY) db-init-local SQL_DUMP_FILE=$(SQL_DUMP_FILE) PROJECT_DIRECTORY=$(ROOT_DIRECTORY)

phpstan:
	$(MAKE) -C $(DOCKER_DIRECTORY) phpstan PROJECT_DIRECTORY=$(ROOT_DIRECTORY) PHPSTAN_CMD=$(or $(cmd),report)

phpcs:
	$(MAKE) -C $(DOCKER_DIRECTORY) phpcs PROJECT_DIRECTORY=$(ROOT_DIRECTORY) PHPCS_CMD=$(or $(cmd),check)

e2e:
	$(MAKE) -C $(DOCKER_DIRECTORY) e2e PROJECT_DIRECTORY=$(ROOT_DIRECTORY) E2E_CMD=$(or $(cmd),npx playwright test)
