#!/bin/sh
# Public entry point; Python is an implementation detail of the shared setup.
set -eu
setup_directory=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
if ! command -v python3 >/dev/null 2>&1; then
    echo 'Klaida: reikia Python 3.10 arba naujesnio (python3).' >&2
    exit 1
fi
exec python3 "$setup_directory/create_project.py" "$@"
