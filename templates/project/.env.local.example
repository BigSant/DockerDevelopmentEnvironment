# Copy to .env.local and fill in the values for this machine.
DOMAIN=example.local
LOCALHOST_PORT=0
LOCALHOST_PORT_SSL=0
DATABASE_USER=example
DATABASE_NAME=example
DATABASE_PASSWORD='replace-with-local-password'
# Choose unused ports before provisioning the host.

# Local hybrid: cache enabled, local identity and mail policy retained.
# CACHE_MODE=on
# MAIL_MODE=off
# PHP_OPCACHE_VALIDATE_TIMESTAMPS=on
# PS_SMARTY_COMPILE=check
