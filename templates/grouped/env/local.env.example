# Copy to local.env and fill in the values for this machine.

# PrestaShop
# PrestaShop only: uncomment either on or ip mode to override common.env.
# PS_DEBUG_MODE=on
# PS_DEBUG_MODE=ip
# PS_DEBUG_IPS=127.0.0.1,::1

# Address
# Choose unused ports before provisioning the host (0: make bootstrap picks free ones).
DOMAIN=example.local
LOCALHOST_PORT=0
LOCALHOST_PORT_SSL=0

# Database
DATABASE_NAME=example
DATABASE_USER=example
DATABASE_PASSWORD='replace-with-local-password'

# Runtime
# Local hybrid: cache enabled, local identity and mail policy retained.
# CACHE_MODE=on
# MAIL_MODE=off
# PHP_OPCACHE_VALIDATE_TIMESTAMPS=on
# PS_SMARTY_COMPILE=check
