PROJECT_NAME=__PROJECT_NAME__
# PHP_VERSION and PROFILE inherit the shared defaults; override for your application.
REDIS_VERSION=7.4
PROJECT_COMPOSE_FILES=compose/qa.yaml compose/doctrine.yaml compose/redis.yaml
POST_IMPORT_SQL_DIRECTORY=__DOCKER_RELATIVE__/database/after-import
SCHEMA_DIRECTORY=__DOCKER_RELATIVE__/database/schema
FIXTURES_DIRECTORY=__DOCKER_RELATIVE__/database/fixtures
PHPSTAN_BASELINE_FILE=/tmp/phpstan/baselines/phpstan.neon
PLAYWRIGHT_COMMAND=npx playwright test --config=/e2e/config/playwright.config.cjs
