# Project
PROJECT_NAME=__PROJECT_NAME__
# Select PROFILE=prestashop (PrestaShop) or another application profile explicitly.
PROFILE=

# Versions
# PHP_VERSION inherits the shared default.

# PrestaShop
# Only ps/prestashop: off, on, or ip. Empty leaves existing defines.inc.php unmanaged.
PS_DEBUG_MODE=off
PS_DEBUG_IPS=

# Services
# Optional CORE services; the four core services always run.
SERVICES=pma mailpit cron redis php-phpstan php-cs playwright

# Database as code
SCHEMA_DIRECTORY=__DOCKER_RELATIVE__/database/schema
POST_IMPORT_SQL_DIRECTORY=__DOCKER_RELATIVE__/database/after-import
FIXTURES_DIRECTORY=__DOCKER_RELATIVE__/database/fixtures

# Runtime
# Runtime behavior is independent of ENV and optional service profiles.
CACHE_MODE=auto
MAIL_MODE=auto
HTTP_FORCE_HTTPS=auto

# Tools
PROJECT_COMPOSE_FILES=compose/qa.yaml compose/doctrine.yaml
PHPSTAN_BASELINE_FILE=/tmp/phpstan/baselines/phpstan.neon
PLAYWRIGHT_COMMAND=npx playwright test --config=/e2e/config/playwright.config.cjs
