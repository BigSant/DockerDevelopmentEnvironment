# Copy to prod.env and supply real production settings. Never commit prod.env.

# PrestaShop
PS_DEBUG_MODE=off
PS_DEBUG_IPS=

# Address
DOMAIN=example.com
LOCALHOST_PORT=0
LOCALHOST_PORT_SSL=0
# Ports on 127.0.0.1 behind DirectAdmin; a VPN server without DirectAdmin sets its VPN address (e.g. 10.8.0.14).
PUBLISH_ADDRESS=127.0.0.1

# Access
# Web tools (PMA, Mailpit, cron UI) on stage/prod start only behind a client IP allowlist.
ALLOWED_IPS=

# Database
DATABASE_NAME=example
DATABASE_USER=example
DATABASE_PASSWORD='replace-with-production-password'
